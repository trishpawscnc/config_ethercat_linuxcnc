# ==========================================
# AUTO GENERATED HAL – FULL PDO SUPPORT
# ==========================================

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadusr -W lcec_conf ethercat-conf.xml
loadrt cia402 count=3
loadrt lcec

addf lcec.read-all servo-thread
addf cia402.0.read-all servo-thread
addf cia402.1.read-all servo-thread
addf cia402.2.read-all servo-thread

addf motion-command-handler servo-thread
addf motion-controller servo-thread

addf cia402.0.write-all servo-thread
addf cia402.1.write-all servo-thread
addf cia402.2.write-all servo-thread
addf lcec.write-all servo-thread

setp iocontrol.0.emc-enable-in 1

# ======================================================================
# -------- AXIS Y / joint.1 / cia402.0 / slave.0 / name="axis_y"--------
# ======================================================================

setp cia402.0.pos-scale 25983.0
setp cia402.0.csp-mode 1

net Y-pos-cmd joint.1.motor-pos-cmd => cia402.0.pos-cmd
net Y-pos-fb cia402.0.pos-fb => joint.1.motor-pos-fb
net Y-enable joint.1.amp-enable-out => cia402.0.enable
net Y-amp-fault cia402.0.drv-fault => joint.1.amp-fault-in
net Y-custom-home joint.1.request-custom-homing => cia402.0.home
net Y-is-custom-homing cia402.0.stat-homing => joint.1.is-custom-homing
net Y-custom-home-done cia402.0.stat-homed => joint.1.custom-homing-finished

net Y-control-word cia402.0.controlword => lcec.0.1.control-word
net Y-target-position cia402.0.drv-target-position => lcec.0.1.target-position
net Y-opmode cia402.0.opmode => lcec.0.1.opmode
net Y-actual-position cia402.0.drv-actual-position => lcec.0.1.actual-position
net Y-actual-velocity cia402.0.drv-actual-velocity => lcec.0.1.actual-velocity
net Y-opmode-display cia402.0.opmode-display => lcec.0.1.opmode-display
net Y-status-word lcec.0.1.status-word => cia402.0.statusword

# ======================================================================
# -------- AXIS Z / joint.2 / cia402.1 / slave.1 / name="axis_z" --------
# ======================================================================

setp cia402.1.pos-scale 25983.0
setp cia402.1.csp-mode 1

net Z-pos-cmd joint.2.motor-pos-cmd => cia402.1.pos-cmd
net Z-pos-fb cia402.1.pos-fb => joint.2.motor-pos-fb
net Z-enable joint.2.amp-enable-out => cia402.1.enable
net Z-amp-fault cia402.1.drv-fault => joint.2.amp-fault-in
net Z-custom-home joint.2.request-custom-homing => cia402.1.home
net Z-is-custom-homing cia402.1.stat-homing => joint.2.is-custom-homing
net Z-custom-home-done cia402.1.stat-homed => joint.2.custom-homing-finished

net Z-control-word cia402.1.controlword => lcec.0.2.control-word
net Z-target-position cia402.1.drv-target-position => lcec.0.2.target-position
net Z-opmode cia402.1.opmode => lcec.0.2.opmode
net Z-actual-position cia402.1.drv-actual-position => lcec.0.2.actual-position
net Z-actual-velocity cia402.1.drv-actual-velocity => lcec.0.2.actual-velocity
net Z-opmode-display cia402.1.opmode-display => lcec.0.2.opmode-display
net Z-status-word lcec.0.2.status-word => cia402.1.statusword

# ======================================================================
# -------- AXIS X / joint.0 / cia402.2 / slave.2 / name="axis_x"--------
# ======================================================================

setp cia402.2.pos-scale 25983.0
setp cia402.2.csp-mode 1

net X-pos-cmd joint.0.motor-pos-cmd => cia402.2.pos-cmd
net X-pos-fb cia402.2.pos-fb => joint.0.motor-pos-fb
net X-enable joint.0.amp-enable-out => cia402.2.enable
net X-amp-fault cia402.2.drv-fault => joint.0.amp-fault-in
net X-custom-home joint.0.request-custom-homing => cia402.2.home
net X-is-custom-homing cia402.2.stat-homing => joint.0.is-custom-homing
net X-custom-home-done cia402.2.stat-homed => joint.0.custom-homing-finished

net X-control-word cia402.2.controlword => lcec.0.0.control-word
net X-target-position cia402.2.drv-target-position => lcec.0.0.target-position
net X-opmode cia402.2.opmode => lcec.0.0.opmode
net X-actual-position cia402.2.drv-actual-position => lcec.0.0.actual-position
net X-actual-velocity cia402.2.drv-actual-velocity => lcec.0.0.actual-velocity
net X-opmode-display cia402.2.opmode-display => lcec.0.0.opmode-display
net X-status-word lcec.0.0.status-word => cia402.2.statusword
setp lcec.0.3.spindle-controlword 1

# ===================================
# Spindle / slave 3 / MD520+MD500ECAT
# ===================================
# ------- Spindle Control / slave 3 / MD520+MD500ECAT ---------

# Load components: scaling, float->s32 converter and universal multiplexer
loadrt scale count=2
loadrt conv_float_s32 count=1
loadrt conv_s32_float count=1
# config="uu2" configures: input types u32, output type u32, 2 channels
loadrt mux_generic config="uu2"

# Add modules to the real-time thread
addf scale.0 servo-thread
addf scale.1 servo-thread
addf conv-float-s32.0 servo-thread
addf conv-s32-float.0 servo-thread
addf mux-gen.00 servo-thread

# --- START / STOP COMMAND SEQUENCER CONFIGURATION (M3 / M5) ---
# Set unsigned u32 values for the multiplexer (pin names strictly per LinuxCNC manual):
setp mux-gen.00.in-u32-00 5  # If spindle is off (M5) -> output code 5 (Stop for Inovance)
setp mux-gen.00.in-u32-01 1  # If spindle is on (M3)  -> output code 1 (Forward Run for Inovance)

# Link the spindle execution bit from G-code to the selector input (sel)
net spindle-enable-bit     spindle.0.on => mux-gen.00.sel-bit-00

# Forward the completed unsigned integer command (1 or 5) from multiplexer to VFD EtherCAT pin
net spindle-cmd-word       mux-gen.00.out-u32 => lcec.0.3.spindle-controlword


# --- FREQUENCY CALCULATION AND ASSIGNMENT CONFIGURATION (SXXXX) ---
# Scaling factor: 40000 (0.01 Hz at 400Hz) / 24000 (max RPM) = 1.666666
setp scale.0.gain 1.666666

# Feedback calculation factor: 24000 (max RPM) / 40000 (0.01 Hz at 400Hz) = 0.6
setp scale.1.gain 0.6


# 1. Capture raw RPM from motion controller (e.g., S12000 sends float 12000.0)
net spindle-speed-raw      spindle.0.speed-out => scale.0.in

# 2. Scale float RPM to float frequency in hundredths of Hz (12000 * 1.666666 = 20000.0)
net spindle-freq-float     scale.0.out => conv-float-s32.0.in

# 3. Convert float to signed integer S32 and forward to VFD target frequency EtherCAT pin
net spindle-freq-cmd       conv-float-s32.0.out => lcec.0.3.spindle-target-frequency


# --- ACTUAL SPEED FEEDBACK CONFIGURATION FOR INTERFACE / GUI ---
# 1. Read actual frequency s32 from EtherCAT and forward to converter input
net spindle-freq-fb-raw    lcec.0.3.spindle-actual-frequency => conv-s32-float.0.in

# 2. Forward converted float value to the second scaling module scale.1 input
net spindle-freq-fb-float  conv-s32-float.0.out => scale.1.in

# 3. Send final scaled float speed (RPM) to motion controller for GUI display
net spindle-freq-fb        scale.1.out => spindle.0.speed-in
